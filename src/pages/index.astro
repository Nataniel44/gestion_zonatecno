---
import Layout from '../layouts/Layout.astro';

const WA = '5493755538503';
const wa = (msg: string) => `https://wa.me/${WA}?text=${encodeURIComponent(msg)}`;

const servicios = [
  {
    icon: '📱',
    t: 'Celulares',
    d: 'Pantalla rota, no carga, se mojó, no se escucha o la batería no dura. Cambiamos pin de carga, módulo, batería y hacemos limpieza.',
    m: 'Hola, tengo un problema con mi celular. Modelo: ',
  },
  {
    icon: '💻',
    t: 'Computadoras',
    d: 'No prende, anda lento, se reinicia o tiene virus. Formateo, Windows, limpieza, cambio de disco o memoria.',
    m: 'Hola, tengo un problema con mi compu (notebook / PC). ',
  },
  {
    icon: '🖨️',
    t: 'Impresoras',
    d: 'No imprime, mancha la hoja o no reconoce el cartucho. Epson L3150, L3210 y L3250. Limpieza y configuración.',
    m: 'Hola, tengo un problema con mi impresora. Modelo: ',
  },
];

const precios = [
  {
    t: 'Cambio de pin de carga',
    p: '$28.000',
    d: 'Incluye repuesto y mano de obra. La mayoría se entrega en el día.',
    m: 'Hola, quiero presupuesto para cambiar el pin de carga. Mi celu es: ',
  },
  {
    t: 'Cambio de pantalla',
    p: '$55.000',
    d: 'Colocada. El precio final depende del modelo; te confirmamos antes.',
    m: 'Hola, se rompió la pantalla de mi celu. Modelo: ',
  },
  {
    t: 'Mantenimiento de impresora',
    p: '$35.000',
    d: 'Limpieza de cabezal, prueba de impresión y configuración.',
    m: 'Hola, mi impresora mancha o no imprime. Modelo: ',
  },
  {
    t: 'Windows y limpieza de PC',
    p: 'Consultar',
    d: 'Formateo, programas básicos y limpieza interna del equipo.',
    m: 'Hola, quiero Windows / limpieza para mi compu: ',
  },
];

const preguntas = [
  {
    q: '¿Cuánto tarda el arreglo?',
    a: 'La mayoría de los arreglos se hacen en el día. Si hay que pedir un repuesto, te avisamos por WhatsApp cuándo llega.',
  },
  {
    q: '¿Tengo que dejar seña?',
    a: 'No. Primero revisamos el equipo, te pasamos el presupuesto y empezamos recién cuando vos decís que sí.',
  },
  {
    q: '¿Qué pasa si no se puede arreglar?',
    a: 'Te lo decimos antes de empezar. Te devolvemos el equipo y te contamos qué opciones tenés.',
  },
  {
    q: '¿Qué garantía tengo?',
    a: '90 días por escrito sobre la reparación. Si falla lo mismo, lo revisamos sin cargo.',
  },
  {
    q: '¿Puedo pasar sin turno?',
    a: 'Sí. Estamos de lunes a sábado, de 9 a 13 y de 16 a 20. Si querés, escribinos antes y te esperamos.',
  },
  {
    q: '¿Qué tengo que llevar?',
    a: 'El cargador y, si es una computadora, la contraseña. Si es un celular, avisanos si tiene cuenta de Google o iCloud.',
  },
];
---

<Layout>
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      <span>Celulares <i>•</i> Computadoras <i>•</i> Impresoras <i>•</i> Precio antes de reparar <i>•</i> Garantía 90 días <i>•</i> Aviso por WhatsApp <i>•</i> San Vicente centro&nbsp;&nbsp;</span>
      <span>Celulares <i>•</i> Computadoras <i>•</i> Impresoras <i>•</i> Precio antes de reparar <i>•</i> Garantía 90 días <i>•</i> Aviso por WhatsApp <i>•</i> San Vicente centro&nbsp;&nbsp;</span>
    </div>
  </div>

  <!-- HERO -->
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="kicker">Taller en San Vicente, Misiones</span>
        <h1>Arreglamos tu celu, compu o impresora <span>con precio claro.</span></h1>
        <p class="lead">
          Te decimos cuánto sale <b>antes de empezar</b>. No avanzamos sin tu OK.
          Estamos en el centro de San Vicente y te avisamos por WhatsApp cuando está listo.
        </p>
        <div class="hero-cta">
          <a href={wa('Hola, quiero un presupuesto. Mi equipo es: ')} target="_blank" rel="noopener" class="btn btn-primary">
            Pedir presupuesto por WhatsApp
          </a>
          <a href="#precios" class="btn btn-ghost">Ver precios</a>
        </div>
        <div class="trust">
          <div><strong>Mismo día</strong><span>la mayoría de los arreglos</span></div>
          <div><strong>90 días</strong><span>de garantía escrita</span></div>
          <div><strong>Sin sorpresas</strong><span>precio antes de reparar</span></div>
        </div>
      </div>

      <div class="ticket reveal visible">
        <div class="ticket-head"><b>¿Ya dejaste tu equipo?</b><span>Te damos un código ZT</span></div>
        <div class="ticket-body">
          <p style="color:var(--muted);font-size:.92rem">
            Buscá el código que te dimos cuando lo dejaste y escribilo acá.
            Te respondemos con el estado y el precio.
          </p>
          <div class="tracker-input">
            <input id="ticketInput" placeholder="Ej: ZT-1834" maxlength="12" aria-label="Código de tu arreglo" />
            <a class="btn btn-primary" id="ticketBtn" target="_blank" rel="noopener" href={wa('Hola, quiero saber cómo va mi arreglo. Código: ')}>Consultar</a>
          </div>
          <p class="ticket-help">¿Perdiste el código? Escribinos igual y lo buscamos con tu nombre.</p>
        </div>
        <div class="ticket-foot">
          <a href="#como-funciona" class="btn btn-ghost btn-block">Ver cómo funciona ↓</a>
        </div>
      </div>
    </div>
  </section>

  <!-- QUÉ ARREGLAMOS -->
  <section id="arreglos" style="padding-top:2.2rem;padding-bottom:2.2rem">
    <div class="container">
      <div class="section-head reveal">
        <div class="eyebrow">Qué arreglamos</div>
        <h2>Elegí tu equipo y contanos qué le pasa</h2>
        <p>Tocá una opción y se abre WhatsApp con el mensaje listo para enviar.</p>
      </div>
      <div class="grid-3">
        {servicios.map((s) => (
          <a class="card service-card reveal" href={wa(s.m)} target="_blank" rel="noopener">
            <span class="service-ico" aria-hidden="true">{s.icon}</span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
            <b class="service-link">Consultar por WhatsApp →</b>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CÓMO FUNCIONA -->
  <section id="como-funciona" style="background:#050c14;border-block:1px solid var(--line);padding-top:2.2rem;padding-bottom:2.2rem">
    <div class="container split">
      <div class="reveal">
        <div class="eyebrow">Cómo funciona</div>
        <h2>Así de simple</h2>
        <p style="color:var(--muted);margin-top:.5rem">
          Sin vueltas ni sorpresas. Vos aprobás el precio antes de que toquemos el equipo.
        </p>
        <div class="how-steps">
          <div class="how">
            <b>1</b>
            <div><strong>Escribinos o traelo</strong><small>Contanos qué le pasa por WhatsApp o pasá por el local. No hace falta turno.</small></div>
          </div>
          <div class="how">
            <b>2</b>
            <div><strong>Te pasamos el precio</strong><small>Revisamos el equipo y te decimos cuánto sale y cuánto tarda. No empezamos sin tu OK.</small></div>
          </div>
          <div class="how">
            <b>3</b>
            <div><strong>Lo retirás andando</strong><small>Te avisamos por WhatsApp. Pagás cuando lo retirás y te llevás la garantía por escrito.</small></div>
          </div>
        </div>
      </div>

      <div class="panel reveal">
        <div class="eyebrow">Para tener en cuenta</div>
        <h3 style="margin:.4rem 0 .8rem">Lo que conviene saber</h3>
        <ul class="check-list" style="margin-top:0">
          <li><span class="check">✓</span> Si decidís no arreglarlo, no avanzamos.</li>
          <li><span class="check">✓</span> Si hay que pedir un repuesto, te avisamos el tiempo.</li>
          <li><span class="check">✓</span> Tus datos y tus fotos quedan como estaban.</li>
          <li><span class="check">✓</span> La garantía es por escrito, de 90 días.</li>
        </ul>
        <a class="btn btn-primary btn-block" style="margin-top:1.2rem" href={wa('Hola, quiero hacer una consulta antes de llevar mi equipo.')} target="_blank" rel="noopener">
          Hacer una consulta
        </a>
      </div>
    </div>
  </section>

  <!-- PRECIOS -->
  <section id="precios" style="padding-top:2.2rem;padding-bottom:2.2rem">
    <div class="container">
      <div class="section-head reveal">
        <div class="eyebrow">Precios de referencia</div>
        <h2>¿Cuánto sale?</h2>
        <p>El total depende del modelo y del repuesto. Siempre te confirmamos por WhatsApp antes de reparar.</p>
      </div>
      <div class="grid-4">
        {precios.map((p) => (
          <div class="card price-card reveal">
            <h3>{p.t}</h3>
            <div class="p-price" style="margin:.3rem 0">{p.p}</div>
            <p style="font-size:.86rem;min-height:3.2rem">{p.d}</p>
            <a class="btn btn-primary btn-block btn-sm" style="margin-top:.8rem" target="_blank" rel="noopener" href={wa(p.m)}>
              Pedir por WhatsApp
            </a>
          </div>
        ))}
      </div>
      <div class="pro-note reveal">
        <span class="pro-ico" aria-hidden="true">✓</span>
        <span><b>Precio antes de reparar.</b> Si el arreglo no conviene, no avanzamos.</span>
      </div>
    </div>
  </section>

  <!-- PREGUNTAS -->
  <section id="ayuda" style="background:#050c14;border-block:1px solid var(--line);padding-top:2.2rem;padding-bottom:2.2rem">
    <div class="container">
      <div class="section-head reveal">
        <div class="eyebrow">Preguntas frecuentes</div>
        <h2>Las dudas más comunes</h2>
      </div>
      <div class="faq-grid">
        {preguntas.map((p) => (
          <div class="card faq-card reveal">
            <h3>{p.q}</h3>
            <p>{p.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACTO -->
  <section id="contacto" style="padding-top:2.2rem;padding-bottom:2.2rem">
    <div class="container split">
      <div class="reveal">
        <div class="eyebrow">Contacto</div>
        <h2>Escribinos o pasá por el local</h2>
        <p style="color:var(--muted);margin-top:.4rem">
          Contanos qué equipo es y qué le pasa. Si podés, mandanos una foto.
        </p>
        <div style="display:grid;gap:.7rem;margin-top:1.2rem">
          <a class="contact-item" href={wa('Hola, necesito ayuda con mi equipo.')} target="_blank" rel="noopener">
            <span class="contact-ico">💬</span>
            <span><b>WhatsApp</b><small>3755 53-8503 · respondemos en el horario del local</small></span>
          </a>
          <div class="contact-item">
            <span class="contact-ico">📍</span>
            <span><b>San Vicente centro, Misiones</b><small>Pasá por el local, no hace falta turno</small></span>
          </div>
          <div class="contact-item">
            <span class="contact-ico">🕘</span>
            <span><b>Lunes a sábado</b><small>9 a 13 y 16 a 20</small></span>
          </div>
        </div>
        <div style="display:flex;gap:.6rem;flex-wrap:wrap;margin-top:1.2rem">
          <a class="btn btn-primary" target="_blank" rel="noopener" href={wa('Hola, necesito ayuda con mi equipo.')}>Abrir WhatsApp</a>
          <a class="btn btn-ghost" href="tel:+5493755538503">Llamar al 3755 53-8503</a>
        </div>
      </div>

      <form class="panel reveal" id="contactForm">
        <h3 style="margin-bottom:.9rem">Pedí tu presupuesto</h3>
        <div class="field">
          <label for="nombre">Tu nombre</label>
          <input id="nombre" name="nombre" autocomplete="name" placeholder="Ej: Juan" />
        </div>
        <div class="field">
          <label for="mensaje">¿Qué equipo tenés y qué le pasa?</label>
          <textarea id="mensaje" name="mensaje" rows="3" required placeholder="Ej: Samsung A14 no carga, ¿cuánto sale?"></textarea>
        </div>
        <button class="btn btn-primary btn-block" type="submit">Enviar por WhatsApp</button>
        <p style="color:var(--muted);font-size:.8rem;margin-top:.7rem">
          No se cobra nada por consultar. Te respondemos en el horario del local.
        </p>
      </form>
    </div>
  </section>

  <script define:vars={{ WA }}>
    const input = document.getElementById('ticketInput');
    const ticketBtn = document.getElementById('ticketBtn');
    function updateTicketLink() {
      const code = (input.value || '').trim().toUpperCase();
      const msg = 'Hola, quiero saber cómo va mi arreglo.' + (code ? ' Código: ' + code : ' No tengo el código, mi nombre es: ');
      ticketBtn.href = `https://wa.me/${WA}?text=${encodeURIComponent(msg)}`;
    }
    input.addEventListener('input', updateTicketLink);
    updateTicketLink();

    document.getElementById('contactForm').onsubmit = (e) => {
      e.preventDefault();
      const data = new FormData(e.target);
      const nombre = String(data.get('nombre') || '').trim();
      const mensaje = String(data.get('mensaje') || '').trim();
      const saludo = nombre ? `Hola, soy ${nombre}. ` : 'Hola, soy de San Vicente. ';
      open(`https://wa.me/${WA}?text=${encodeURIComponent(saludo + mensaje)}`, '_blank');
    };
  </script>
</Layout>
