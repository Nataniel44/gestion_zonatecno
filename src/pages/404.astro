---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada — ZonaTecno" description="Esa página ya no está. Volvé al inicio para ver los arreglos de celulares, computadoras e impresoras en San Vicente.">
  <section class="hero" style="min-height:60vh;display:grid;place-items:center">
    <div class="container" style="text-align:center;max-width:34rem">
      <div class="eyebrow">Página no encontrada</div>
      <h1 style="margin:.6rem 0">Esa página ya no está</h1>
      <p style="color:var(--muted)">
        Ahora nos dedicamos a arreglar celulares, computadoras e impresoras en San Vicente.
        Te llevamos al inicio en un segundo.
      </p>
      <div style="display:flex;gap:.7rem;justify-content:center;flex-wrap:wrap;margin-top:1.4rem">
        <a class="btn btn-primary" href="/">Ir al inicio</a>
        <a class="btn btn-ghost" href="/#contacto">Contactarnos</a>
      </div>
    </div>
  </section>
  <script is:inline>
    setTimeout(() => location.replace('/'), 1500);
  </script>
</Layout>
